# Normalize line endings across platforms (Windows / WSL / macOS)
# Files are stored with LF in the repo; checked out with native EOL.
* text=auto

# Source files
*.c     text
*.h     text
*.py    text
*.java  text
*.xml   text
*.md    text
Makefile text

# Build artifacts (never normalize)
*.o       binary
demo-test binary
*.class   binary
*.jar     binary
